# ==============================================
# TRENZY BACKEND — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================

# Application environment
# Set to "production" for all non-local deployments.
APP_ENV=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=trenzy
DB_HOST=localhost
DB_PORT=5432

# Redis (required in production; optional in development)
REDIS_URL=redis://localhost:6379/0

# Firebase Configuration
# Get these from Firebase Console → Project Settings
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
# Firebase project ID (Console → Project settings → General). Enables
# real ID-token verification against Google's public certificates even
# without a service account. Revocation checks require the service account.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# One of the following must be set for token verification:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json

# CORS — update with your actual production domain(s)
# PRODUCTION EXAMPLE: https://trenzy.com,https://app.trenzy.com
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Payment Gateway
# PAYMENTS_MODE=simulation  → dev/testing only, no real money
# PAYMENTS_MODE=razorpay    → REQUIRED in production
PAYMENTS_MODE=simulation
# FOR PRODUCTION:
# RAZORPAY_KEY_ID=rzp_live_your_live_key_here
# RAZORPAY_KEY_SECRET=your_live_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# PAYMENT_CHECKOUT_SECRET=generate_with_openssl_rand_hex_32

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8000/uploads

# Request body cap (bytes). Protects against huge JSON payloads / DoS.
MAX_REQUEST_BODY_BYTES=1000000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text   # Use "json" in production

# Error tracking (optional)
# SENTRY_DSN=https://...

# Trust reverse-proxy headers (only set to true behind a trusted load balancer)
# TRUST_X_FORWARDED_FOR=false

# ==============================================
# DEV-ONLY — DISABLE IN PRODUCTION
# ==============================================
# WARNING: DEV_AUTH_BYPASS bypasses all Firebase auth checks.
# It will be REFUSED at startup when APP_ENV=production.
DEV_AUTH_BYPASS=false
DEV_AUTH_UID=dev-user-123
# Set this to a long random secret: openssl rand -hex 32
DEV_AUTH_SECRET=CHANGE_ME_random_secret_here
DEV_AUTH_NAME=Dev User
DEV_AUTH_EMAIL=dev@example.com
# Beta launch scope: affiliate-first. Set true only for the post-launch direct-commerce phase.
TRENZY_BETA_COMMERCE_ENABLED=false
