# ==============================================================================
# TRENZY BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.production on your production server.
# Ensure file permissions are restrictive: chmod 600 .env.production
# NEVER commit your production credentials or .env.production to version control.
# ==============================================================================

# Application Environment (MUST be "production")
APP_ENV=production

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=trenzy_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
POSTGRES_DB=trenzy
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Redis Configuration (Required for multi-instance rate limiting & WebSockets)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Firebase Authentication (trenzy2400)
# ------------------------------------------------------------------------------
# Web API Key for Identity Toolkit token verification
FIREBASE_API_KEY=AIzaSyBMRiWHWzGTDCEfmZ8m8h927jnnU4eTAeM
# Project ID (Console → Project settings → General). Minimum requirement:
# real ID-token signature verification against Google's public certificates.
FIREBASE_PROJECT_ID=trenzy2400

# Service Account credentials for Firebase Admin SDK (adds token revocation
# checks and user management on top of public-cert verification):
# Option A: Mount a file (recommended for Docker compose):
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase_service_account.json
# Option B: Pass raw JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ------------------------------------------------------------------------------
# 4. Allowed Origins (Strict; NO wildcards '*' allowed in production)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://trenzy.com,https://app.trenzy.com
SOCKET_ALLOWED_ORIGINS=https://trenzy.com,https://app.trenzy.com

# ------------------------------------------------------------------------------
# 5. Live Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Must be "razorpay" for real users (simulation is blocked in production)
PAYMENTS_MODE=razorpay
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Optional custom checkout signing secret (falls back to RAZORPAY_WEBHOOK_SECRET)
PAYMENT_CHECKOUT_SECRET=REPLACE_WITH_CHECKOUT_SIGNING_SECRET

# ------------------------------------------------------------------------------
# 6. File Storage & Public URLs
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=https://api.trenzy.com/uploads

# ------------------------------------------------------------------------------
# 7. Error Tracking & Monitoring (Optional but recommended)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 8. Security Controls (Enforced)
# ------------------------------------------------------------------------------
DEV_AUTH_BYPASS=false
DEV_AUTH_UID=
DEV_AUTH_SECRET=

# Beta launch scope: affiliate-first. Set true only for the post-launch direct-commerce phase.
TRENZY_BETA_COMMERCE_ENABLED=false
